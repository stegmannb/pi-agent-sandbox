{
  "name": "pi-sandbox",
  "version": "0.3.0",
  "description": "OS-level sandboxing for pi with interactive permission prompts",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carderne/pi-sandbox.git"
  },
  "author": "Chris Arderne <chris@rdrn.me>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/carderne/pi-sandbox/issues"
  },
  "homepage": "https://github.com/carderne/pi-sandbox",
  "scripts": {
    "fmt": "oxfmt index.ts protection.ts *.mts *.mjs tests/*.mjs extensions/**/*.ts",
    "lint": "oxlint index.ts protection.ts *.mjs tests/*.mjs extensions/**/*.ts",
    "check": "tsc --noEmit",
    "ci:fmt": "oxfmt --check index.ts protection.ts *.mts *.mjs tests/*.mjs extensions/**/*.ts",
    "ci:lint": "pnpm run lint",
    "ci:check": "pnpm run check",
    "test": "node --import ./protection-source.mjs --test tests/*.test.mjs",
    "test:loader": "node tests/run-loader.mjs && node tests/run-installed.mjs",
    "test:os": "node tests/run-os.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.52"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "^0.61.0"
  },
  "peerDependenciesMeta": {
    "@mariozechner/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mariozechner/pi-ai": "^0.61.1",
    "@mariozechner/pi-coding-agent": "^0.61.1",
    "@types/node": "^24",
    "oxfmt": "^0.33.0",
    "oxlint": "^1.48.0",
    "typescript": "^5"
  },
  "overrides": {
    "minimatch": ">=10.2.1"
  }
}
